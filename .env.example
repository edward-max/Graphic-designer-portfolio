# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for Koby's Admin CMS (/admin)
ADMIN_PASSWORD="koby2026"

# SESSION_SECRET: Secret key used to sign admin session tokens
SESSION_SECRET="change_this_to_a_long_random_secret"

# Optional Supabase configuration (if connecting an external Supabase project)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
